generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL yahan se remove kar diya gaya hai kyunki Prisma 7 isey ab config file se read karta hai
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}
